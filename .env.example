# Salin menjadi .env lalu isi. File .env TIDAK ikut ke GitHub.

# ===== Server AI (kunci hanya dibaca server, bukan browser) =====
# Isi SATU saja. Penyedia dipilih otomatis dari kunci yang terisi (atau paksa dengan AI_PROVIDER).

# Opsi 1 (disarankan, ada tingkat gratis, bisa baca gambar): Google Gemini
# Buat kunci di https://aistudio.google.com/apikey
GEMINI_API_KEY=isi-kunci-gemini-di-sini
# AI_MODEL=gemini-3.8-flash

# Opsi 2: OpenAI atau yang kompatibel (Groq, OpenRouter, Mistral, dll)
# OPENAI_API_KEY=isi-kunci-di-sini
# AI_BASE_URL=https://api.groq.com/openai/v1      # kosongkan untuk OpenAI asli
# AI_MODEL=nama-model-yang-bisa-membaca-gambar

# Opsi 3: Anthropic (Claude)
# ANTHROPIC_API_KEY=isi-kunci-di-sini
# AI_MODEL=claude-sonnet-5-5

# AI_PROVIDER=gemini        # opsional: paksa penyedia (gemini | openai | anthropic)

# ===== Supabase (dukungan laporan tersimpan permanen) =====
# Supabase > Project Settings > API. Kunci "anon" aman di browser. JANGAN pakai "service_role" di sini.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=isi-kunci-anon-di-sini
